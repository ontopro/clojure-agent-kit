;; HOW A FAMILY IS REACHED - what the two shipped profiles already say, as one table, so that a
;; model named by its slug alone ("x-ai/grok-4.7", or "grok" resolved through `bb models`) can be
;; turned into a full role block: the endpoint, the key's variable, the tool-call shape, the
;; provider pin that keeps one host answering, the effort parameter and its levels, and the
;; :max_tokens a family needs. `harness.models.catalogue/route` reads it; a family that is not
;; here is refused by name, because a route nobody wrote is a request nobody checked.
;;
;; The family is the slug's prefix on OpenRouter (`anthropic/…`, `openai/…`, `google/…`, `x-ai/…`).
;; `:anthropic-direct` is the same family reached at its own API with its own shape - the route
;; agy-ide.edn's reviewers take. `:google-direct` is Gemini at Google's OpenAI-compatible endpoint: no provider to pin, Gemini's thought
;; signature returned on each tool call (`adapter/parse :openai`), its errors read from an array. NOTHING READS A `-direct` ROUTE: `catalogue` takes a
;; model's family from its slug's prefix, so `bb models` builds the OpenRouter block; the direct
;; routes are what a person copies into a profile's role, the model named as the provider names it.
;;
;; EFFORT LEVELS BELONG TO THE MODEL, NOT THE FAMILY. OpenRouter's listing gives each model's own
;; (`reasoning.supported_efforts`), and they differ inside a family - Gemini 4 Argon takes no xhigh,
;; GLM 5.3 no medium - so `expand-candidate` holds a line to its model's levels from the listing, and
;; the levels here are the family's FALLBACK, for a model the listing gives none: every level the
;; listing shows for the family's models (2026-11-02). A direct route's are its family's on OpenRouter,
;; the same models' levels standing in for the provider's own documentation (the person, 2026-11-02) -
;; less `none` at Anthropic's API, which OpenRouter's reasoning documentation says Claude rejects.
;; A line that names no effort is read at `medium` (`catalogue/default-effort`), and refused, with the
;; model's levels named, where the model has no medium. A level is checked against the host before a
;; paid run by the pre-run probe, not here.
;;
;; NO KEYS, EVER: :key-env NAMES an environment variable.

{:anthropic {:endpoint "https://openrouter.ai/api/v1"
             :key-env "OPENROUTER_API_KEY"
             :shape :openai
             :provider "anthropic"
             :effort {:param :reasoning_effort :levels ["none" "low" "medium" "high" "xhigh" "max"]}
             :max_tokens 16000}
 :openai {:endpoint "https://openrouter.ai/api/v1"
          :key-env "OPENROUTER_API_KEY"
          :shape :openai
          :provider "openai"
          :effort {:param :reasoning_effort :levels ["none" "minimal" "low" "medium" "high" "xhigh" "max"]}}
 :google {:endpoint "https://openrouter.ai/api/v1"
          :key-env "OPENROUTER_API_KEY"
          :shape :openai
          :provider "google-vertex"
          :effort {:param :reasoning_effort :levels ["none" "minimal" "low" "medium" "high"]}}
 :x-ai {:endpoint "https://openrouter.ai/api/v1"
        :key-env "OPENROUTER_API_KEY"
        :shape :openai
        :provider "xai"
        :effort {:param :reasoning_effort :levels ["none" "low" "medium" "high" "xhigh"]}}
 ;; Alibaba is the one host OpenRouter lists for glm-5.3-prime (2026-10-08) and one of many for
 ;; glm-5.3, so the pin serves both; it takes tools and reasoning_effort on each.
 :z-ai {:endpoint "https://openrouter.ai/api/v1"
        :key-env "OPENROUTER_API_KEY"
        :shape :openai
        :provider "alibaba"
        :effort {:param :reasoning_effort :levels ["none" "low" "high" "xhigh" "max"]}}
 ;; Alibaba is the one host OpenRouter lists for qwen3.8-max-0902 (2026-11-02, two tags of it).
 :qwen {:endpoint "https://openrouter.ai/api/v1"
        :key-env "OPENROUTER_API_KEY"
        :shape :openai
        :provider "alibaba"
        :effort {:param :reasoning_effort :levels ["none" "minimal" "low" "medium" "high" "xhigh"]}}
 ;; Meta is the one host OpenRouter lists for muse-wonder (2026-11-02).
 :meta {:endpoint "https://openrouter.ai/api/v1"
        :key-env "OPENROUTER_API_KEY"
        :shape :openai
        :provider "meta"
        :effort {:param :reasoning_effort :levels ["minimal" "low" "medium" "high" "xhigh" "max"]}}
 :google-direct {:endpoint "https://generativelanguage.googleapis.com/v1beta/openai"
                 :key-env "GEMINI_API_KEY"
                 :shape :openai
                 :effort {:param :reasoning_effort :levels ["none" "minimal" "low" "medium" "high"]}}
 :anthropic-direct {:endpoint "https://api.anthropic.com"
                    :key-env "ANTHROPIC_API_KEY"
                    :shape :anthropic
                    :effort {:param :output_config :levels ["low" "medium" "high" "xhigh" "max"]}
                    :max_tokens 16000}}
