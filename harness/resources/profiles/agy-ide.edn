;; The `agy-ide` seat's profile: the model each dispatched role uses and how it is reached. A
;; worked example - `bb init --seat agy-ide` copies it to <name>-build/profile.edn; edit it
;; there, and `bb profile` checks it. No build has run this seat yet. Its roles are the `claude`
;; example's, all but the orchestrator.
;;
;; - :key-env NAMES an environment variable; never put a key in this file.
;; - The verifiers - the Tester, the code reviewer, the spec and plan reviewers, the security
;;   reviewer - may not share the Coder's family, and the Tester and the code reviewer not each
;;   other's. `bb profile` checks it.
;; - :shape :anthropic is Anthropic's API, direct: the adapter asks for prompt caching on every
;;   request unless :params says `:cache_control nil` (say it on a role that reads its prompt
;;   once); the cost is computed from :pricing and marked ~; the API has no balance, and its key is
;;   a credit stop of its own. :max_tokens goes in :params - thinking counts against it.
;; - :shape :openai is OpenRouter: the reply carries the cost, and `bb balance` reads the credit.
;;   :provider pins the host; without :allow_fallbacks false it can change between calls.
;; - :max-rounds caps a role's completions in one dispatch (the harness's default is 24).
;; - Models are dated selections, said in the DEVLOG. `bb profile` says when a newer model is
;;   listed; `bb bake-off` compares candidates on your own cases.

{:seat :agy-ide

 :roles
 {;; CODER - writes the implementation in its own worktree and nREPL. 2026-10-16.
  :coder {:family :google
          :model "google/gemini-4-argon"
          :shape :openai
          :endpoint "https://openrouter.ai/api/v1"
          :key-env "OPENROUTER_API_KEY"
          :params {:reasoning_effort "medium"
                   :provider {:only ["google-vertex"] :allow_fallbacks false}}}

  ;; TESTER - writes the tests from the contract alone, a test per target, so it takes more
  ;; rounds than the Coder. Choose it by its tests, not its price. 2026-10-16.
  :tester {:family :anthropic
           :max-rounds 40
           :model "claude-sonnet-5-5"
           :shape :anthropic
           :endpoint "https://api.anthropic.com"
           :key-env "ANTHROPIC_API_KEY"
           :params {:output_config {:effort "medium"}
                    :max_tokens 16000}
           :pricing {:per-mtok {:in 2 :out 10
                                :cache-write-5m 2.5 :cache-write-1h 4
                                :cache-read 0.2}
                     :source "https://platform.claude.com/docs/en/about-claude/pricing"
                     :as-of "2026-10-16"}}

  ;; CODE REVIEWER - reads the diff against the contract once the gates are green.
  :reviewer {:family :openai
             :model "openai/gpt-6.1-sol"
             :shape :openai
             :endpoint "https://openrouter.ai/api/v1"
             :key-env "OPENROUTER_API_KEY"
             :params {:reasoning_effort "high"
                      :provider {:only ["openai"] :allow_fallbacks false}}}

  ;; PLAN REVIEWER - reads the plan, or a stage plan, cold: one call per stage (`bb plan-review`).
  :plan-reviewer {:family :openai
                  :model "openai/gpt-6.1-sol"
                  :shape :openai
                  :endpoint "https://openrouter.ai/api/v1"
                  :key-env "OPENROUTER_API_KEY"
                  :params {:reasoning_effort "high"
                           :provider {:only ["openai"] :allow_fallbacks false}}}

  ;; SPEC REVIEWER - reads each packet's spec cold before its first dispatch.
  :spec-reviewer {:family :openai
                  :model "openai/gpt-6.1-sol"
                  :shape :openai
                  :endpoint "https://openrouter.ai/api/v1"
                  :key-env "OPENROUTER_API_KEY"
                  :params {:reasoning_effort "high"
                           :provider {:only ["openai"] :allow_fallbacks false}}}

  ;; BLUEPRINT REVIEWER - reads a stage's Blueprint whole before sign-off: one call
  ;; (`bb blueprint-review`).
  :blueprint-reviewer {:family :anthropic
                       :model "claude-opus-5-5"
                       :shape :anthropic
                       :endpoint "https://api.anthropic.com"
                       :key-env "ANTHROPIC_API_KEY"
                       :params {:output_config {:effort "high"}
                                :max_tokens 16000
                                :cache_control nil}
                       :pricing {:per-mtok {:in 4 :out 20
                                            :cache-write-5m 5 :cache-write-1h 8
                                            :cache-read 0.4}
                                 :source "https://platform.claude.com/docs/en/about-claude/pricing"
                                 :as-of "2026-10-16"}}

  ;; SECURITY REVIEWER - once per stage, reads the merged application with its tools in a sandbox
  ;; with no network; a finding counts only when a test of its own fails (`bb security-review`).
  :security-reviewer {:family :openai
                      :model "openai/gpt-6-astra"
                      :shape :openai
                      :endpoint "https://openrouter.ai/api/v1"
                      :key-env "OPENROUTER_API_KEY"
                      :params {:reasoning_effort "high"
                               :provider {:only ["openai"] :allow_fallbacks false}}}

  ;; ORCHESTRATOR - triage only: one call on a red gate, a note or a rejection, routing it to the
  ;; Coder, the Tester, the Architect or a person. Not a verifier, so any family - here the
  ;; seat's and the Coder's. 2026-10-16.
  :orchestrator {:family :google
                 :model "google/gemini-4-argon"
                 :shape :openai
                 :endpoint "https://openrouter.ai/api/v1"
                 :key-env "OPENROUTER_API_KEY"
                 :params {:reasoning_effort "medium"
                          :provider {:only ["google-vertex"] :allow_fallbacks false}}}}}
