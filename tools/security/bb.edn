;; THE SECURITY TOOL PACK - run from a project's own folder, against the project's own running
;; server, through this file:
;;
;;   bb --config <kit>/tools/security/bb.edn check [--serve "<cmd>"] [--health <path>] [--base <url>]
;;                                                [--running] [--routes <file>] [--out <dir>] [--record <file>]
;;
;; `<kit>` is the KIT's clone. No dependency: Babashka's sockets are enough, and nothing of the
;; application is read - only its answers. It serves through the browser pack's `server.clj`,
;; so the two packs travel together. README.md beside this file says what each row tries.
{:tasks
 {:init (do (require '[babashka.fs :as fs])
            ;; where this pack is: the config bb was given, which is this file
            (def pack-dir (str (fs/parent (fs/absolutize (System/getProperty "babashka.config"))))))

  check {:doc "Serve (unless --running), try the response headers, cookies, CSRF, the routes that need a login, error pages, static folders and TLS from outside; a table, a record, exit 1 on a failing row"
         :task (System/exit (:exit (apply shell {:continue true} "bb" (str pack-dir "/check.bb") *command-line-args*)))}}}
