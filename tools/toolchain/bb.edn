;; THE TOOLCHAIN PACK - the tools the KIT runs on, held to exact versions and checksums, run from
;; anywhere through this file:
;;
;;   bb --config <kit>/tools/toolchain/bb.edn status [--edn]
;;   bb --config <kit>/tools/toolchain/bb.edn toolchain-install [--only <tool>,…] [--link <dir>] [--dry-run]
;;   bb --config <kit>/tools/toolchain/bb.edn toolchain-sum <tool> [<version>]
;;   bb --config <kit>/tools/toolchain/bb.edn fmt|fmt-check [--dir <d>] <paths…>
;;
;; `<kit>` is the KIT's clone. download-matrix.edn beside this file names what the pack fetches;
;; README.md says what each task does and where the tools go (`~/.kit/toolchain/`). The harness
;; reaches the pack only as a subprocess, never by requiring it. Plan 7.0, item 8, adds the tasks
;; that install the tools and run them.
{:paths ["src"]
 ;; THE LIBRARIES THE PACK LOADS, at exact versions (plan 7.0, item 8.2): bb fetches each into ~/.m2 at
 ;; first use - `toolchain-install` ahead of time - and `bb kit-pins` reads its pin from here.
 :deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
 :tasks
 {:init (do (require '[babashka.fs :as fs])
            ;; where this pack is: the config bb was given, which is this file
            (def pack-dir (str (fs/parent (fs/absolutize (System/getProperty "babashka.config"))))))

  status {:doc "A row per tool of the download matrix this machine takes: its version, where the pack puts it, whether it is there. --edn: the map bb doctor will read (plan 7.0, item 8.2e)"
          :requires ([toolchain-status :as status])
          :task (status/main pack-dir *command-line-args*)}

  toolchain-install {:doc "Fetch each tool of the download matrix this machine takes into the toolchain cache, its sha256 checked before it is unpacked (a mismatch is deleted and refused); the archives kept in <cache>/downloads/. --only <tool>,… (an image-only tool only when named; the JDK only when named), --link <dir> the executables linked there, --dry-run the plan alone"
                     :requires ([toolchain-install :as install])
                     :task (install/install-main pack-dir *command-line-args*)}

  fmt {:doc "cljfmt fix over <paths…> from --dir (default here): each file held to the first cljfmt config found from its own folder up, else from --dir's; `Reformatted <path>` for each it changed. Exit 2 when a file could not be read"
       :requires ([toolchain-fmt :as fmt])
       :task (fmt/main :fix *command-line-args*)}

  fmt-check {:doc "cljfmt check over <paths…> from --dir (default here), each file's config as `fmt` finds it: `<path> has incorrect formatting` and the diff, then the count, as cljfmt says them. Exit 1 for a file formatted incorrectly, 2 for one that could not be read"
             :requires ([toolchain-fmt :as fmt])
             :task (fmt/main :check *command-line-args*)}

  toolchain-env {:doc "The shell lines for `eval \"$(bb toolchain-env)\"`: JAVA_HOME and PATH for the JDK the project pins (the download matrix's when none), and the line that has the shell load the workspace's .env - no value ever printed; any name taken, held by no repository, a line the shell would run or a program hook flagged, and a flagged file not loaded unless `env-accept` accepted it; a change to the file is added to the .env record (.env-record.edn beside it) - names, never a value. [<dir>], default KIT_WORKSPACE or here. Exit 1: nothing on stdout when the .env is flagged or a repository holds it; the keys line alone when no JDK of that major is found. JDK-only until 8.3c: the cache's bb, clj-kondo and clojure are not on its PATH line"
                 :requires ([toolchain-env :as env])
                 :task (env/main pack-dir *command-line-args*)}

  env-accept {:doc "The person's acceptance of the .env as it is now, flagged lines and all: the flags shown by line number (never the text), their name and the word accept typed at a terminal, the file's sha256 added to the .env record (.env-record.edn beside it) - every load after says who accepted it and when. [<dir>] as toolchain-env's. Refused with no terminal (a command an agent runs has none), for a file a repository holds, or one that changed while the answers were given"
              :requires ([toolchain-env :as env])
              :task (env/accept-main pack-dir *command-line-args*)}

  image-args {:doc "The KIT's toolchain image's build arguments for a Linux platform (linux-aarch64, linux-amd64), as an EDN map: bb's and git's version, URL and sha256 from the download matrix - what the image fetches by shell before bb exists. Read by the root `docker-image!`"
              :requires ([toolchain-download-matrix :as dm])
              :task (try (prn (dm/image-args (dm/read-matrix (str pack-dir "/download-matrix.edn"))
                                             (some-> (first *command-line-args*) keyword)))
                         (catch clojure.lang.ExceptionInfo e
                           (binding [*out* *err*] (println (str "image-args: " (ex-message e))))
                           (System/exit 1)))}

  toolchain-sum {:doc "Fetch each platform's archive of a tool once, take its sha256, set it beside the publisher's checksum and the matrix's; the lines to paste. Exit 1 when one differs from its publisher's"
                 :requires ([toolchain-install :as install])
                 :task (install/sum-main pack-dir *command-line-args*)}}}
