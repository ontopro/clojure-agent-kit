n  {:expr/op operator :expr/left left :expr/right right})\n\n(deftest leaves-render-directly\n  (testing \"literal values use decimal notation, including negatives\"\n    (is (= \"-3\" (render/render (literal -3))))\n    (is (= \"0\" (render/render (literal 0))))\n    (is (= \"42\" (render/render (literal 42)))))\n  (testing \"variables render as their names\"\n    (is (= \"alpha_2\" (render/render (variable \"alpha_2\"))))))\n\n(deftest every-operator-renders-with-its-symbol-and-spaces\n  (doseq [[operator symbol] [[:add \"+\"]\n                             [:sub \"-\"]\n                             [:mul \"*\"]\n                             [:div \"/\"]]]\n    (is (= (str \"1 \" symbol \" x\")\n           (render/render (binary operator (literal 1) (variable \"x\"))))\n        (str \"operator \" operator))))\n\n(deftest parentheses-record-right-branching-only\n  (let [left-leaning (binary :add\n                             (binary :mul (literal 1) (literal 2))\n                             (literal 3))\n        right-leaning (binary :add\n                              (literal 1)\n                              (binary :mul (literal 2) (literal 3)))\n        nested-right (binary :add\n                             (literal 1)\n                             (binary :mul\n                                     (literal 2)\n                                     (binary :sub (literal 3) (literal 4))))]\n    (testing \"an operator in the left operand is never parenthesized\"\n      (is (= \"1 * 2 + 3\" (render/render left-leaning))))\n    (testing \"an operator in the right operand is parenthesized at each level\"\n      (is (= \"1 + (2 * 3)\" (render/render right-leaning)))\n      (is (= \"1 + (2 * (3 - 4))\" (render/render nested-right))))\n    (testing \"trees over the same leaves with different shapes remain distinct\"\n      (is (not= (render/render left-leaning)\n                (render/render right-leaning))))))\n\n(deftest parsed-expressions-round-trip-without-parentheses\n  (doseq [source [\"-3\"\n                  \"alpha\"\n                  \"1 + 2\"\n                  \"1 + 2 * 3\"\n                  \"alpha / -3 - beta\"\n                  \"9 - 4 + 2 / gamma_1\"]]\n    (let [tree (parse/parse source)\n          rendered (render/render tree)]\n      (is (not (re-find #\"[()]\" rendered)) source)\n      (is (= tree (parse/parse rendered)) source))))\n\n(deftest invalid-expressions-report-the-shape-error\n  (doseq [invalid-expr [nil\n                        {:expr/op :literal :expr/value \"3\"}\n                        (binary :add\n                                (literal 1)\n                                {:expr/op :var :expr/name \"\"})]]\n    (try\n      (render/render invalid-expr)\n      (is false (str \"expected invalid expression rejection for \"\n                     (pr-str invalid-expr)))\n      (catch clojure.lang.ExceptionInfo ex\n        (is (= :invalid-expr (:sandbox/error (ex-data ex))))))))\n\n(deftest render-validates-once-at-entry\n  (let [check-calls (atom [])\n        original-check! shapes/check!\n        tree (binary :add\n                     (binary :mul (literal 1) (variable \"x\"))\n                     (binary :sub (literal 2) (literal 3)))]\n    (with-redefs [shapes/check! (fn [where expression]\n                                  (swap! check-calls conj [where expression])\n                                  (original-check! where expression))]\n      (is (= \"1 * x + (2 - 3)\" (render/render tree))))\n    (is (= 1 (count @check-calls)))\n    (is (= tree (second (first @check-calls))))))\n\n(deftest render-has-only-the-declared-runtime-dependencies\n  (is (= #{'sandbox.expr 'sandbox.shapes}\n         (set (map ns-name (vals (ns-aliases 'sandbox.render))))))\n  (is (nil? (get (ns-aliases 'sandbox.render) 'parse))))\n"}}