epend on it: sandbox.parse is a fixture for the tests and the round-trip\n  property, not an implementation dependency.\n\n  sandbox.parse folds tokens left-to-right with no precedence and no\n  parentheses, so a right operand it produces is always a leaf. render only\n  wraps an operand in parentheses when it is the RIGHT operand of an\n  operator node and is itself an operator node; the left operand is never\n  wrapped. That keeps every tree sandbox.parse produces rendering with no\n  parentheses at all, while still letting render distinguish shapes (such as\n  a left-leaning tree from a right-leaning one) that sandbox.parse itself\n  never builds.\"\n  (:require\n   [sandbox.expr :as expr]\n   [sandbox.shapes :as shapes]))\n\n(def ^:private sym->str\n  {:add \"+\" :sub \"-\" :mul \"*\" :div \"/\"})\n\n(defn- operator-node?\n  [e]\n  (not (or (expr/literal? e) (expr/variable? e))))\n\n(defn- render*\n  \"Render an already-validated `e`. Private: the seam validates once, this\n  recurses without re-checking every subtree.\"\n  [e]\n  (cond\n    (expr/literal? e) (str (:expr/value e))\n    (expr/variable? e) (:expr/name e)\n    :else\n    (let [{:expr/keys [op left right]} e\n          left-str (render* left)\n          right-str (render* right)\n          right-str (if (operator-node? right)\n                      (str \"(\" right-str \")\")\n                      right-str)]\n      (str left-str \" \" (sym->str op) \" \" right-str))))\n\n(defn render\n  \"Render `e` to text. Validated once at this entry; `render*` assumes the\n  shape from here down.\"\n  [e]\n  (shapes/check! ::render e)\n  (render* e))\n", "test/sandbox/render_test.clj" "(ns sandbox.render-test\n  (:require\n   [clojure.test :refer [are deftest is testing]]\n   [sandbox.parse :as parse]\n   [sandbox.render :as render]\n   [sandbox.shapes :as shapes]))\n\n(defn literal [value]\n  {:expr/op :literal :expr/value value})\n\n(defn variable [variable-name]\n  {:expr/op :var :expr/name variable-name})\n\n(defn binary [operator left right]\n  {:expr/op operator :expr/left left :expr/right right})\n\n(deftest renders-leaves\n  (testing \"a literal renders as its decimal value\"\n    (are [value expected] (= expected (render/render (literal value)))\n      -3 \"-3\"\n      0 \"0\"\n      42 \"42\"))\n  (testing \"a variable renders as its name\"\n    (are [variable-name] (= variable-name\n                            (render/render (variable variable-name)))\n      \"x\"\n      \"total\")))\n\n(deftest renders-each-operator-with-spaces\n  (are [operator symbol]\n      (= (str \"8 \" symbol \" n\")\n         (render/render (binary operator (literal 8) (variable \"n\"))))\n    :add \"+\"\n    :sub \"-\"\n    :mul \"*\"\n    :div \"/\"))\n\n(deftest parentheses-are-used-only-for-an-operator-on-the-right\n  (let [left-operator (binary :sub (literal 9) (variable \"x\"))\n        right-operator (binary :div (literal 6) (literal 2))]\n    (is (= \"9 - x * (6 / 2)\"\n           (render/render (binary :mul left-operator right-operator))))\n    (is (= \"9 - x * 6\"\n           (render/render (binary :mul left-operator (literal 6)))))))\n\n(deftest rendering-preserves-tree-shape\n  (let [left-leaning (binary :add\n                             (binary :add (variable \"a\") (variable \"b\"))\n                             (variable \"c\"))\n        right-leaning (binary :add\n                              (variable \"a\")\n                              (binary :add (variable \"b\") (variable \"c\")))\n        left-rendered (render/render left-leaning)\n        right-rendered (render/render right-leaning)]\n    (is (= \"a + b + c\" left-rendered))\n    (is (= \"a + (b + c)\" right-rendered))\n    (is (not= left-rendered right-rendered))))\n\n(deftest parsed-expressions-round-trip-without-parentheses\n  (doseq [source [\"-3\"\n                  \"alpha\"\n                  \"1 + 2\"\n                  \"alpha + 2 * beta - -3\"\n                  \"8 / 2 / 2\"\n                  \"a + b - c * d / 4\"]]\n    (let [expression (parse/parse source)\n          rendered (render/render expression)]\n      (is (= expression (parse/parse rendered)) source)\n      (is (not (re-find #\"[()]\" rendered)) source))))\n\n(deftest rejects-an-invalid-expression-with-contract-error\n  (let [invalid-expression {:expr/op :add\n                            :expr/left (literal 1)\n                            :expr/right {:expr/op :literal\n                                         :expr/value \"not-an-integer\"}}\n        exception (try\n                    (render/render invalid-expression)\n                    nil\n                    (catch clojure.lang.ExceptionInfo ex\n                      ex))]\n    (is (some? exception))\n    (is (= :invalid-expr (:sandbox/error (ex-data exception))))))\n\n(deftest validates-only-once-at-entry\n  (let [expression (binary :mul\n                           (binary :sub (literal 9) (variable \"x\"))\n                           (binary :div (literal 6) (literal 2)))\n        calls (atom [])\n        original-check! shapes/check!]\n    (with-redefs [shapes/check! (fn [where candidate]\n                                  (swap! calls conj [where candidate])\n                                  (original-check! where candidate))]\n      (is (= \"9 - x * (6 / 2)\" (render/render expression))))\n    (is (= 1 (count @calls)))\n    (is (= expression (second (first @calls))))))\n\n(deftest implementation-does-not-alias-parser\n  (let [sandbox-aliases (->> (ns-aliases 'sandbox.render)\n                             vals\n                             (map ns-name)\n                             (filter #(= \"sandbox\" (namespace %)))\n                             set)]\n    (is (not (contains? sandbox-aliases 'sandbox.parse)))))\n"}}