t :refer [defspec]]\n   [clojure.test.check.generators :as gen]\n   [clojure.test.check.properties :as prop]\n   [sandbox.expr :as expr]\n   [sandbox.paths :as paths]))\n\n(def leaf-gen\n  (gen/one-of\n   [(gen/fmap expr/literal gen/small-integer)\n    (gen/fmap expr/variable (gen/elements [\"x\" \"y\" \"z\" \" \"]))]))\n\n(def expr-gen\n  (gen/recursive-gen\n   (fn [inner-gen]\n     (gen/let [op (gen/elements [:add :sub :mul :div])\n               left-expr inner-gen\n               right-expr inner-gen]\n       (expr/binary op left-expr right-expr)))\n   leaf-gen))\n\n(def search-name-gen\n  (gen/elements [\"x\" \"y\" \"z\" \" \" \"absent-name\"]))\n\n(defn reference-paths\n  [expression sought-name]\n  (letfn [(walk [node path]\n            (cond\n              (= :var (:expr/op node))\n              (if (= sought-name (:expr/name node))\n                [path]\n                [])\n\n              (= :literal (:expr/op node))\n              []\n\n              :else\n              (into (walk (:expr/left node) (conj path :left))\n                    (walk (:expr/right node) (conj path :right)))))]\n    (walk expression [])))\n\n(defn follow-path\n  [expression path]\n  (reduce (fn [node direction]\n            (case direction\n              :left (:expr/left node)\n              :right (:expr/right node)))\n          expression\n          path))\n\n(defn caught-ex-info\n  [thunk]\n  (try\n    (thunk)\n    nil\n    (catch clojure.lang.ExceptionInfo ex\n      ex)))\n\n(deftest root-order-and-absence-examples\n  (testing \"a matching root variable has the empty path\"\n    (is (= [[]] (paths/paths-to (expr/variable \"x\") \"x\"))))\n  (testing \"a non-matching root and a literal have no paths\"\n    (is (= [] (paths/paths-to (expr/variable \"y\") \"x\")))\n    (is (= [] (paths/paths-to (expr/literal 7) \"x\"))))\n  (testing \"matches are depth-first with the left branch before the right branch\"\n    (let [expression\n          (expr/binary :add\n                       (expr/binary :mul\n                                    (expr/variable \"x\")\n                                    (expr/variable \"y\"))\n                       (expr/binary :sub\n                                    (expr/variable \"x\")\n                                    (expr/binary :add\n                                                 (expr/literal 1)\n                                                 (expr/variable \"x\"))))]\n      (is (= [[:left :left]\n              [:right :left]\n              [:right :right :right]]\n             (paths/paths-to expression \"x\")))\n      (is (= [] (paths/paths-to expression \"not-present\"))))))\n\n(defspec paths-are-complete-unique-valid-and-ordered 150\n  (prop/for-all [expression expr-gen\n                 sought-name search-name-gen]\n    (let [actual (paths/paths-to expression sought-name)\n          expected (reference-paths expression sought-name)]\n      (and (vector? actual)\n           (every? vector? actual)\n           (every? (fn [path]\n                     (every? #{:left :right} path))\n                   actual)\n           (= expected actual)\n           (= (count actual) (count (distinct actual)))\n           (every? (fn [path]\n                     (let [reached (follow-path expression path)]\n                       (and (= :var (:expr/op reached))\n                            (= sought-name (:expr/name reached)))))\n                   actual)))))\n\n(deftest invalid-expression-wins-over-invalid-name\n  (doseq [invalid-expression\n          [nil\n           {:expr/op :literal :expr/value \"not-an-integer\"}\n           {:expr/op :add\n            :expr/left {:expr/op :var :expr/name \"x\"}}\n           {:expr/op :mul\n            :expr/left {:expr/op :literal :expr/value 1}\n            :expr/right {:expr/op :var :expr/name \"\"}}]]\n    (let [ex (caught-ex-info #(paths/paths-to invalid-expression nil))]\n      (is (instance? clojure.lang.ExceptionInfo ex))\n      (is (= :invalid-expr (:sandbox/error (ex-data ex)))))))\n\n(deftest invalid-name-is-rejected-after-a-valid-expression\n  (let [expression (expr/binary :add\n                                (expr/variable \"x\")\n                                (expr/literal 2))]\n    (doseq [invalid-name [nil \"\" :x 0 [] {}]]\n      (let [ex (caught-ex-info #(paths/paths-to expression invalid-name))]\n        (is (instance? clojure.lang.ExceptionInfo ex))\n        (is (= :invalid-name (:sandbox/error (ex-data ex))))\n        (is (= invalid-name (:name (ex-data ex))))))))\n"}}