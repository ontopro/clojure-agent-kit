and operator\n  nodes keep their values, operators and operand positions.\"\n  [e m]\n  (shapes/check! ::rename e)\n  (when-not (valid-renaming? m)\n    (throw (ex-info \"invalid renaming\"\n                     {:sandbox/error :invalid-renaming\n                      :renaming m})))\n  (letfn [(walk [node]\n            (cond\n              (expr/literal? node) node\n              (expr/variable? node) (if (contains? m (:expr/name node))\n                                       (expr/variable (get m (:expr/name node)))\n                                       node)\n              :else (expr/binary (:expr/op node)\n                                  (walk (:expr/left node))\n                                  (walk (:expr/right node)))))]\n    (walk e)))\n", "test/sandbox/rename_test.clj" "(ns sandbox.rename-test\n  (:require\n   [clojure.test :refer [deftest is testing]]\n   [sandbox.expr :as expr]\n   [sandbox.rename :as rename]\n   [sandbox.shapes :as shapes]))\n\n(def literal-seven\n  {:expr/op :literal :expr/value 7})\n\n(def expression\n  (expr/binary :mul\n               (expr/binary :add\n                            (expr/variable \"a\")\n                            literal-seven)\n               (expr/variable \"b\")))\n\n(deftest rename-produces-a-valid-expression\n  (let [result (rename/rename expression {\"a\" \"alpha\"\n                                          \"b\" \"beta\"})]\n    (is (= result (shapes/check! ::rename-result result)))))\n\n(deftest rename-replaces-matching-variables-at-any-depth\n  (let [result (rename/rename expression {\"a\" \"alpha\"})]\n    (is (= \"alpha\" (get-in result [:expr/left :expr/left :expr/name])))\n    (is (= \"b\" (get-in result [:expr/right :expr/name])))))\n\n(deftest rename-is-simultaneous\n  (let [result (rename/rename expression {\"a\" \"b\"\n                                          \"b\" \"c\"})]\n    (is (= \"b\" (get-in result [:expr/left :expr/left :expr/name])))\n    (is (= \"c\" (get-in result [:expr/right :expr/name])))))\n\n(deftest rename-preserves-tree-structure-and-literals\n  (testing \"an empty renaming leaves the complete expression equal\"\n    (is (= expression (rename/rename expression {}))))\n  (testing \"renaming leaves operators, literals, and operand positions intact\"\n    (is (= {:expr/op :mul\n            :expr/left {:expr/op :add\n                        :expr/left {:expr/op :var :expr/name \"renamed-a\"}\n                        :expr/right literal-seven}\n            :expr/right {:expr/op :var :expr/name \"renamed-b\"}}\n           (rename/rename expression {\"a\" \"renamed-a\"\n                                      \"b\" \"renamed-b\"})))))\n\n(deftest injective-renaming-can-be-inverted\n  (let [renaming {\"a\" \"first\"\n                  \"b\" \"second\"}\n        inverse {\"first\" \"a\"\n                 \"second\" \"b\"}]\n    (is (= expression\n           (-> expression\n               (rename/rename renaming)\n               (rename/rename inverse))))))\n\n(deftest invalid-expression-is-rejected-before-invalid-renaming\n  (doseq [invalid-expression\n          [{:expr/op :var :expr/name \"\"}\n           {:expr/op :add\n            :expr/left (expr/variable \"a\")\n            :expr/right {:expr/op :literal :expr/value \"not-an-integer\"}}]]\n    (try\n      (rename/rename invalid-expression :not-a-map)\n      (is false \"expected an invalid expression exception\")\n      (catch clojure.lang.ExceptionInfo exception\n        (is (= :invalid-expr (:sandbox/error (ex-data exception))))))))\n\n(deftest invalid-renaming-is-rejected\n  (doseq [invalid-renaming\n          [nil\n           []\n           {\"\" \"valid\"}\n           {\"valid\" \"\"}\n           {:keyword \"valid\"}\n           {\"valid\" :keyword}\n           {1 \"valid\"}\n           {\"valid\" 1}]]\n    (try\n      (rename/rename expression invalid-renaming)\n      (is false (str \"expected invalid renaming exception for \"\n                     (pr-str invalid-renaming)))\n      (catch clojure.lang.ExceptionInfo exception\n        (is (= :invalid-renaming\n               (:sandbox/error (ex-data exception))))\n        (is (= invalid-renaming\n               (:renaming (ex-data exception))))))))\n"}}