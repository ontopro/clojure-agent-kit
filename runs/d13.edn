                          :expr/value 2}\n                :expr/right {:expr/op :literal\n                             :expr/value 3}}})\n\n(deftest leaves-render-as-their-textual-values\n  (is (= \"-3\" (render/render literal-minus-three)))\n  (is (= \"x\" (render/render variable-x))))\n\n(deftest every-operator-renders-with-its-symbol-and-parentheses\n  (are [op expected] (= expected\n                         (render/render {:expr/op op\n                                         :expr/left {:expr/op :literal\n                                                     :expr/value 7}\n                                         :expr/right {:expr/op :var\n                                                      :expr/name \"amount\"}}))\n    :add \"(7 + amount)\"\n    :sub \"(7 - amount)\"\n    :mul \"(7 * amount)\"\n    :div \"(7 / amount)\"))\n\n(deftest rendering-preserves-tree-shape\n  (let [left-text (render/render left-leaning)\n        right-text (render/render right-leaning)]\n    (is (= \"((1 + 2) + 3)\" left-text))\n    (is (= \"(1 + (2 + 3))\" right-text))\n    (is (not= left-text right-text))))\n\n(deftest invalid-expressions-produce-the-shape-boundary-error\n  (testing \"an invalid root\"\n    (let [failure (try\n                    (render/render {:expr/op :literal\n                                    :expr/value \"not-an-integer\"})\n                    nil\n                    (catch clojure.lang.ExceptionInfo ex\n                      ex))]\n      (is (instance? clojure.lang.ExceptionInfo failure))\n      (is (= :invalid-expr (:sandbox/error (ex-data failure))))))\n  (testing \"an invalid nested expression\"\n    (let [failure (try\n                    (render/render {:expr/op :add\n                                    :expr/left literal-minus-three\n                                    :expr/right {:expr/op :var\n                                                 :expr/name \"\"}})\n                    nil\n                    (catch clojure.lang.ExceptionInfo ex\n                      ex))]\n      (is (instance? clojure.lang.ExceptionInfo failure))\n      (is (= :invalid-expr (:sandbox/error (ex-data failure)))))))\n\n(deftest rendering-validates-only-once-at-entry\n  (let [calls (atom [])\n        original-check! shapes/check!\n        rendered (with-redefs [shapes/check!\n                               (fn [where e]\n                                 (swap! calls conj [where e])\n                                 (original-check! where e))]\n                   (render/render left-leaning))]\n    (is (= \"((1 + 2) + 3)\" rendered))\n    (is (= 1 (clojure.core/count @calls)))\n    (is (= left-leaning (second (first @calls))))))\n"}}