s (:expr/right e)))))\n\n(defn var-names\n  \"The distinct variable names in `e`, as a vector of strings sorted ascending.\n  A tree with no :var node gives []. Throws the sandbox.shapes/check! ex-info\n  (:sandbox/error :invalid-expr) when `e` is not an Expr.\"\n  [e]\n  (shapes/check! ::var-names e)\n  (vec (sort (collect-names #{} e))))\n", "test/sandbox/names_test.clj" "(ns sandbox.names-test\n  (:require\n   [clojure.test :refer [deftest is testing]]\n   [sandbox.names :as names]\n   [sandbox.shapes :as shapes]))\n\n(def repeated-name-tree\n  {:expr/op :add\n   :expr/left {:expr/op :var :expr/name \"zeta\"}\n   :expr/right {:expr/op :mul\n                :expr/left {:expr/op :sub\n                            :expr/left {:expr/op :var :expr/name \"alpha\"}\n                            :expr/right {:expr/op :var :expr/name \"zeta\"}}\n                :expr/right {:expr/op :var :expr/name \"middle\"}}})\n\n(def literal-only-tree\n  {:expr/op :div\n   :expr/left {:expr/op :literal :expr/value 12}\n   :expr/right {:expr/op :add\n                :expr/left {:expr/op :literal :expr/value 2}\n                :expr/right {:expr/op :literal :expr/value 4}}})\n\n(deftest var-names-returns-distinct-names-in-ascending-order\n  (let [result (names/var-names repeated-name-tree)]\n    (is (= [\"alpha\" \"middle\" \"zeta\"] result))\n    (is (vector? result))\n    (is (every? string? result))\n    (is (= result (vec (sort result))))\n    (is (= (count result) (count (distinct result))))))\n\n(deftest membership-corresponds-exactly-to-variable-nodes\n  (let [result (names/var-names repeated-name-tree)]\n    (testing \"every variable name occurring in the tree is present\"\n      (is (contains? (set result) \"alpha\"))\n      (is (contains? (set result) \"middle\"))\n      (is (contains? (set result) \"zeta\")))\n    (testing \"non-variable data and absent names are not present\"\n      (is (not (contains? (set result) \"add\")))\n      (is (not (contains? (set result) \"omega\")