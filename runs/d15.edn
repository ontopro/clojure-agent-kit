", :killed? true, :result {:failures 2, :errors 0}}], :survived 0, :original-intact? true, :of 11}], :run/files {"src/sandbox/render.clj" "(ns sandbox.render\n  \"Expression tree to text — the inverse of sandbox.parse for everything parse\n  produces, and faithful for everything else.\n\n  Depends only on sandbox.expr and sandbox.shapes. sandbox.parse is a sibling,\n  not a dependency: render must agree with it without requiring it.\n\n  Output is flat: `left SYMBOL right`. Parse folds left-to-right, so a\n  left-leaning tree needs no grouping and renders with no parentheses at all,\n  which is what makes parse -> render -> parse a round trip. A RIGHT operand\n  that is itself an operator node is the one shape parse cannot produce, so it\n  is wrapped in parentheses and a right-leaning tree renders differently from\n  the left-leaning tree over the same leaves. The left operand is never\n  wrapped.\"\n  (:require\n   [sandbox.expr :as expr]\n   [sandbox.shapes :as shapes]))\n\n(def ^:private symbols\n  {:add \"+\" :sub \"-\" :mul \"*\" :div \"/\"})\n\n(defn- operator?\n  \"An operator node: any Expr that is neither a literal nor a variable.\"\n  [e]\n  (not (or (expr/literal? e) (expr/variable? e))))\n\n(defn- render*\n  \"Interior: assumes `e` is a valid Expr. Validation happened at `render`.\"\n  [e]\n  (cond\n    (expr/literal? e) (str (:expr/value e))\n    (expr/variable? e) (:expr/name e)\n    :else\n    (let [{:expr/keys [op left right]} e\n          rhs (render* right)]\n      (str (render* left)\n           \" \" (symbols op) \" \"\n           (if (operator? right) (str \"(\" rhs \")\") rhs)))))\n\n(defn render\n  \"Render `e` as text. Validated once against the Expr shape at this entry —\n  a seam — and then assumed valid while recursing.\"\n  [e]\n  (render* (shapes/check! ::render e)))\n", "test/sandbox/render_test.clj" "(ns sandbox.render-test\n  (:require\n   [clojure.string :as str]\n   [clojure.test :refer [deftest is testing]]\n   [sandbox.parse :as parse]\n   [sandbox.render :as render]\n   [sandbox.shapes :as shapes]))\n\n(def literal-one\n  {:expr/op :literal :expr/value 1})\n\n(def literal-two\n  {:expr/op :literal :expr/value 2})\n\n(def literal-three\n  {:expr/op :literal :expr/value 3})\n\n(def variable-x\n  {:expr/op :var :expr/name \"x\"})\n\n(def left-leaning\n  {:expr/op :mul\n   :expr/left {:expr/op :add\n               :expr/left literal-one\n               :expr/right literal-two}\n   :expr/right literal-three})\n\n(def right-leaning\n  {:expr/op :add\n   :expr/left literal-one\n   :expr/right {:expr/op :mul\n                :expr/left literal-two\n                :expr/right literal-three}})\n\n(deftest leaves-render-directly\n  (testing \"literals use decimal notation, including negative values\"\n    (is (= \"-3\" (render/render {:expr/op :literal :expr/value -3})))\n    (is (= \"0\" (render/render {:expr/op :literal :expr/value 0})))\n    (is (= \"42\" (render/render {:expr/op :literal :expr/value 42}))))\n  (testing \"variables use their names\"\n    (is (= \"x\" (render/render variable-x)))\n    (is (= \"total-2\" (render/render {:expr/op :var\n                                     :expr/name \"total-2\"})))))\n\n(deftest every-operator-renders-with-its-symbol-and-spaces\n  (doseq [[op symbol] [[:add \"+\"]\n                       [:sub \"-\"]\n                       [:mul \"*\"]\n                       [:div \"/\"]]]\n    (is (= (str \"1 \" symbol \" 2\")\n           (render/render {:expr/op op\n                           :expr/left literal-one\n                           :expr/right literal-two})))))\n\n(deftest parentheses-record-tree-shape\n  (testing \"an operator on the left is never parenthesized\"\n    (is (= \"1 + 2 * 3\" (render/render left-leaning))))\n  (testing \"an operator on the right is parenthesized\"\n    (is (= \"1 + (2 * 3)\" (render/render right-leaning))))\n  (testing \"the rule applies recursively and only to operator nodes\"\n    (is (= \"1 - (2 / (x + -3))\"\n           (render/render\n            {:expr/op :sub\n             :expr/left literal-one\n             :expr/right {:expr/op :div\n                          :expr/left literal-two\n                          :expr/right {:expr/op :add\n                                       :expr/left variable-x\n                                       :expr/right {:expr/op :literal\n                                                    :expr/value -3}}}}))))\n  (testing \"different shapes over the same leaves remain distinguishable\"\n    (is (not= (render/render left-leaning)\n              (render/render right-leaning)))))\n\n(deftest parsed-expressions-round-trip-without-parentheses\n  (doseq [source [\"7\"\n                  \"alpha\"\n                  \"-3 + x\"\n                  \"1 + 2 * 3\"\n                  \"x - -4 / y + 9\"\n                  \"  10   /   two  *  -5  \"]]\n    (let [tree (parse/parse source)\n          rendered (render/render tree)]\n      (is (= tree (parse/parse rendered)) source)\n      (is (not (str/includes? rendered \"(\")) source)\n      (is (not (str/includes? rendered \")\")) source))))\n\n(deftest invalid-expressions-preserve-the-shape-error\n  (doseq [invalid [nil\n                   {:expr/op :literal :expr/value \"3\"}\n                   {:expr/op :var :expr/name \"\"}\n                   {:expr/op :add\n                    :expr/left literal-one\n                    :expr/right {:expr/op :literal}}]]\n    (let [thrown (try\n                   (render/render invalid)\n                   nil\n                   (catch clojure.lang.ExceptionInfo ex\n                     ex))]\n      (is (some? thrown))\n      (is (= :invalid-expr (:sandbox/error (ex-data thrown)))))))\n\n(deftest render-validates-exactly-once-at-entry\n  (let [calls (atom [])\n        original-check! shapes/check!]\n    (with-redefs [shapes/check! (fn [where expression]\n                                  (swap! calls conj [where expression])\n                                  (original-check! where expression))]\n      (is (= \"1 + (2 * 3)\" (render/render right-leaning))))\n    (is (= 1 (count @calls)))\n    (is (= right-leaning (second (first @calls))))))\n\n(deftest implementation-has-no-parser-dependency\n  (let [sandbox-dependencies (->> (ns-aliases 'sandbox.render)\n                                  vals\n                                  (map ns-name)\n                                  (filter #(str/starts-with? (str %) \"sandbox.\"))\n                                  set)]\n    (is (= '#{sandbox.expr sandbox.shapes} sandbox-dependencies))\n    (is (not (contains? sandbox-dependencies 'sandbox.parse)))))\n"}}