      (expr/literal -17)\n                              (expr/binary :mul\n                                           (expr/literal 3)\n                                           (expr/literal 42)))\n        result (bind/bind input bindings)]\n    (is (= expected result))\n    (is (= result (shapes/check! ::bound-result result)))))\n\n(deftest unresolved-and-non-integer-variables-remain-the-same-leaves\n  (let [bindings (bindings-from {\"double\" 2.5\n                                 \"ratio\" 1/2\n                                 \"string\" \"12\"})]\n    (doseq [nm [\"missing\" \"double\" \"ratio\" \"string\"]]\n      (testing (str \"binding for \" nm \" does not resolve to an int? value\")\n        (let [input (variable nm)\n              result (bind/bind input bindings)]\n          (is (identical? input result))\n          (is (= input result)))))))\n\n(deftest operators-and-operand-positions-are-preserved\n  (let [looked-up (atom [])\n        bindings (reify bindings/Bindings\n                   (lookup [_ nm]\n                     (swap! looked-up conj nm)\n                     nil))\n        input (expr/binary :div\n                           (expr/binary :add\n                                        (variable \"first\")\n                                        (expr/literal 8))\n                           (expr/binary :sub\n                                        (variable \"second\")\n                                        (expr/binary :mul\n                                                     (expr/literal 5)\n                                                     (variable \"third\"))))\n        result (bind/bind input bindings)]\n    (is (= input result))\n    (is (= #{\"first\" \"second\" \"third\"}\n           (set @looked-up)))\n    (is (= result (shapes/check! ::unchanged-result result)))))\n\n(deftest binding-is-idempotent-for-fixed-bindings\n  (let [bindings (bindings-from {\"integer\" 9\n                                 \"other\" 9.25})\n        input (expr/binary :add\n                           (variable \"integer\")\n                           (expr/binary :sub\n                                        (variable \"other\")\n                                        (variable \"missing\")))\n        once (bind/bind input bindings)\n        twice (bind/bind once bindings)]\n    (is (= once twice))))\n\n(deftest invalid-expression-is-rejected-at-the-bind-boundary\n  (let [bindings (bindings-from {\"\" 11\n                                 \"resolved\" 12})\n        invalid-expressions [[\"nested invalid variable\"\n                              {:expr/op :add\n                               :expr/left (expr/literal 1)\n                               :expr/right {:expr/op :var :expr/name \"\"}}]\n                             [\"resolved variable with an empty name\"\n                              {:expr/op :var :expr/name \"\"}]\n                             [\"resolved variable carrying an extra key\"\n                              {:expr/op :var\n                               :expr/name \"resolved\"\n                               :unexpected true}]\n                             [\"operator outside the Expr enum\"\n                              {:expr/op :pow\n                               :expr/left (expr/literal 2)\n                               :expr/right (expr/literal 3)}]\n                             [\"nil expression\" nil]]]\n    (doseq [[description invalid] invalid-expressions]\n      (testing description\n        (let [thrown (try\n                       (bind/bind invalid bindings)\n                       nil\n                       (catch clojure.lang.ExceptionInfo ex\n                         ex))]\n          (is (instance? clojure.lang.ExceptionInfo thrown))\n          (is (= :invalid-expr\n                 (:sandbox/error (ex-data thrown)))))))))\n"}}