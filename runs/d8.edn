ccurately to all architectural rules and requirements.", :model "google/gemini-3.8-flash-20260902"} {:method "each mutant a perl substitution on the assembled src/sandbox/bind.clj in the gate worktree, then clojure -M:test; original restored and green after (19 tests, 63 assertions)", :event/kind :mutation, :against :tester-r1, :note "substitutions are the ones run against attempt 2: those naming walk/node in attempt 1 were rewritten for bind/e, and the seam-check mutant deletes the input check line", :event/at-ms 512664, :contract-probe {:note "attempt 2 against property target 6, same inputs and Bindings as attempt 1", :results [{:input "unknown operator :pow", :got "ex-info :sandbox/error :invalid-expr"} {:input "nil", :got "ex-info :sandbox/error :invalid-expr"} {:input ":var with empty name, resolved", :got "ex-info :sandbox/error :invalid-expr"} {:input ":var with an extra key, resolved", :got "ex-info :sandbox/error :invalid-expr"} {:input ":add over an empty-name :var", :got "ex-info :sandbox/error :invalid-expr"}]}, :mutants [{:name "int? becomes number?", :subst "s/\\(if \\(int\\? v\\)/(if (number? v)/", :result "2 errors"} {:name "never binds", :subst "s/\\(if \\(int\\? v\\)/(if false/", :result "1 failure"} {:name "binds the wrong value", :subst "s/\\(expr\\/literal v\\)/(expr\\/literal (inc v))/", :result "1 failure"} {:name "operands swapped", :subst "s/\\(bind \\(:expr\\/left e\\) b\\) \\(bind \\(:expr\\/right e\\) b\\)/(bind (:expr\\/right e) b) (bind (:expr\\/left e) b)/", :result "3 failures"} {:name "not recursive", :subst "s/\\(bind \\(:expr\\/left e\\) b\\) \\(bind \\(:expr\\/right e\\) b\\)/(:expr\\/left e) (:expr\\/right e)/", :result "2 failures"} {:name "operator lost", :subst "s/\\(expr\\/binary \\(:expr\\/op e\\)/(expr\\/binary :add/", :result "2 failures"} {:name "looks up the wrong name", :subst "s/\\(bindings\\/lookup b \\(:expr\\/name e\\)\\)/(bindings\\/lookup b (str (:expr\\/name e) \"_\"))/", :result "2 failures"} {:name "no seam ch