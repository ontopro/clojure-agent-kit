rses through a private helper that trusts the shape — checking\n  at every level would re-validate every subtree and be quadratic on deep\n  input.\"\n  (:require\n   [sandbox.expr :as expr]\n   [sandbox.shapes :as shapes]))\n\n(def ^:private symbols\n  {:add \"+\" :sub \"-\" :mul \"*\" :div \"/\"})\n\n(defn- render*\n  \"Render an already-validated expression. Not a seam.\"\n  [e]\n  (cond\n    (expr/literal? e) (str (:expr/value e))\n    (expr/variable? e) (:expr/name e)\n    :else (str \"(\"\n               (render* (:expr/left e)) \" \"\n               (symbols (:expr/op e)) \" \"\n               (render* (:expr/right e))\n               \")\")))\n\n(defn render\n  \"The text form of `e`: a :literal as its decimal value, a :var as its name,\n  and an operator node as \\\"(left op right)\\\". Throws the ex-info\n  sandbox.shapes/check! throws (:sandbox/error :invalid-expr) when `e` does\n  not satisfy Expr.\"\n  [e]\n  (render* (shapes/check! ::render e)))\n", "test/sandbox/render_test.clj" "(ns sandbox.render-test\n  (:require\n   [clojure.test :refer [deftest is testing]]\n   [sandbox.render :as render]\n   [sandbox.shapes :as shapes]))\n\n(defn- literal [value]\n  {:expr/op :literal :expr/value value})\n\n(defn- variable [variable-name]\n  {:expr/op :var :expr/name variable-name})\n\n(defn- binary [operator left right]\n  {:expr/op operator :expr/left left :expr/right right})\n\n(deftest renders-leaves\n  (testing \"a literal uses its decimal value\"\n    (is (= \"-3\" (render/render (literal -3))))\n    (is (= \"42\" (render/render (literal 42)))))\n  (testing \"a variable uses its name\"\n    (is (= \"total\" (render/render (variable \"total\"))))))\n\n(deftest renders-each-binary-operator-with-canonical-spacing\n  (doseq [[operator symbol] [[:add \"+\"]\n                             [:sub \"-\"]\n                             [:mul \"*\"]\n                             [:div \"/\"]]]\n    (testing (str operator)\n      (is (= (str \"(1 \" symbol \" x)\")\n             (render/render (binary operator\n                                    (literal 1)\n                                    (variable \"x\"))))))))\n\n(deftest renders-nested-trees-with-their-shape\n  (let [left-leaning (binary :mul\n                             (binary :add (literal 1) (literal 2))\n                             (literal 3))\n        right-leaning (binary :add\n                              (literal 1)\n                              (binary :mul (literal 2) (literal 3)))\n        left-rendered (render/render left-leaning)\n        right-rendered (render/render right-leaning)]\n    (is (= \"((1 + 2) * 3)\" left-rendered))\n    (is (= \"(1 + (2 * 3))\" right-rendered))\n    (is (not= left-rendered right-rendered))))\n\n(deftest rejects-values-outside-expr\n  (doseq [invalid-expression [nil\n                              {:expr/op :literal :expr/value \"3\"}\n                              {:expr/op :add\n                               :expr/left (literal 1)\n                               :expr/right {:expr/op :var :expr/name \"\"}}]]\n    (let [caught (try\n                   (render/render invalid-expression)\n                   nil\n                   (catch clojure.lang.ExceptionInfo exception\n                     exception))]\n      (is (instance? clojure.lang.ExceptionInfo caught))\n      (is (= :invalid-expr (:sandbox/error (ex-data caught)))))))\n\n(deftest validates-once-at-the-render-entry\n  (let [tree (binary :sub\n                     (binary :add (literal 8) (variable \"x\"))\n                     (binary :div (literal 6) (literal 2)))\n        calls (atom [])\n        original-check! shapes/check!]\n    (with-redefs [shapes/check! (fn [where expression]\n                                  (swap! calls conj [where expression])\n                                  (original-check! where expression))]\n      (is (= \"((8 + x) - (6 / 2))\" (render/render tree))))\n    (is (= 1 (count @calls)))\n    (is (= tree (second (first @calls))))))\n"}}