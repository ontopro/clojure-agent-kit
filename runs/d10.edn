         :vars #{\"x\" \"y\"}}\n           (measure/measure tree)))))\n\n(deftest repeated-values-and-names\n  (let [tree {:expr/op :add\n              :expr/left {:expr/op :var\n                          :expr/name \"same\"}\n              :expr/right {:expr/op :mul\n                           :expr/left {:expr/op :literal\n                                       :expr/value 5}\n                           :expr/right {:expr/op :add\n                                        :expr/left {:expr/op :var\n                                                    :expr/name \"same\"}\n                                        :expr/right {:expr/op :literal\n                                                     :expr/value 5}}}}]\n    (is (= {:nodes 7\n            :depth 4\n            :literals 2\n            :vars #{\"same\"}}\n           (measure/measure tree)))))\n\n(deftest invalid-expressions-are-rejected\n  (testing \"nil is not an expression\"\n    (is (= :invalid-expr\n           (:sandbox/error (invalid-expr-data nil)))))\n  (testing \"validation covers malformed descendants, not only the root\"\n    (let [malformed {:expr/op :add\n                     :expr/left literal-seven\n                     :expr/right {:expr/op :var\n                                  :expr/name \"\"}}]\n      (is (= :invalid-expr\n             (:sandbox/error (invalid-expr-data malformed)))))))\n"}}